# --- secrets ---
.env
*.env

# --- python virtual environment ---
.venv/
venv/

# --- setup.bat: downloaded ffmpeg + its own log ---
vendor/
setup_log.txt
install_log.txt

# --- installer.iss build output (the compiled Setup.exe) ---
installer/output/

# --- python junk ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- downloaded content / work data (copyrighted scraped material, large files) ---
work/
downloads/
output/
series/
inputs/
projects/

# --- model caches and weights ---
.cache/
*/.cache/
huggingface/
.huggingface/
*.pt
*.pth
*.safetensors
*.onnx
*.ckpt
*.bin

# --- large media anywhere in work/output-style dirs ---
work/**/*.mp4
work/**/*.wav
work/**/*.mp3
work/**/*.png
work/**/*.jpg
work/**/*.jpeg
output/**/*.mp4
output/**/*.wav
output/**/*.mp3
output/**/*.png
output/**/*.jpg
output/**/*.jpeg

# keep small repo assets (e.g. icons) even if they match media patterns above
!assets/**
